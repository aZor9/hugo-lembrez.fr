generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())

  @@map("users")
}

model Cv {
  id        String   @id @default(cuid())
  variant   String   @default("normal") @unique
  fileUrl   String
  fileName  String
  updatedAt DateTime @default(now()) @updatedAt

  @@map("cvs")
}

model Project {
  id          String   @id @default(cuid())
  title       String
  description String
  link        String?  // URL GitHub
  siteUrl     String?  // URL du site live
  tags        String   @default("[]")
  order       Int      @default(0)
  visible     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("projects")
}

model Link {
  id          String   @id @default(cuid())
  name        String
  description String?
  icon        String?  // URL d'icône (emoji ou URL image)
  url         String
  order       Int      @default(0)
  visible     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("links")
}

model Profile {
  id        String   @id @default(cuid())
  name      String
  title     String
  bio       String
  imageUrl  String?
  updatedAt DateTime @default(now()) @updatedAt

  @@map("profiles")
}

model HomeSectionSettings {
  id                     String   @id @default(cuid())
  key                    String   @unique @default("home")
  stacksVisible          Boolean  @default(true)
  stacksTitle            String   @default("Stacks techniques")
  educationVisible       Boolean  @default(true)
  educationTitle         String   @default("Formation")
  educationLeadVisible   Boolean  @default(true)
  educationLeadTitle     String   @default("En recherche d'une formation en alternance")
  educationLeadSubtitle  String   @default("Ouvert aux opportunités")
  updatedAt              DateTime @updatedAt

  @@map("home_section_settings")
}

model StackCategory {
  id        String      @id @default(cuid())
  name      String
  order     Int         @default(0)
  visible   Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  items     StackItem[]

  @@map("stack_categories")
}

model StackItem {
  id          String        @id @default(cuid())
  techId      String
  label       String
  categoryId  String
  category    StackCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  order       Int           @default(0)
  visible     Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@map("stack_items")
}

model EducationItem {
  id          String   @id @default(cuid())
  title       String
  school      String
  period      String
  statusLabel String?  // ex: Obtenu
  description String?
  order       Int      @default(0)
  visible     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("education_items")
}
